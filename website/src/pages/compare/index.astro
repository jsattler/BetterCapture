---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { comparisons } from '../../data/comparisons';
---

<BaseLayout
	title="BetterCapture vs QuickTime, OBS, CleanShot X & Screen Studio | Honest Comparisons"
	description="Honest comparisons of BetterCapture with other Mac screen recorders, including what each competitor does better."
	canonicalUrl="https://bettercapture.app/compare"
>
	<main class="pt-24 sm:pt-28 md:pt-32 pb-12 sm:pb-16 md:pb-20 px-4 sm:px-6">
		<div class="max-w-3xl mx-auto">
			<h1 class="text-2xl sm:text-3xl md:text-4xl font-bold text-white mb-4">How BetterCapture Compares</h1>
			<p class="text-white/70 mb-10">
				BetterCapture is a free, open-source screen recorder for macOS. It isn't the right tool for everyone, so these comparisons cover what other recorders do better, too.
			</p>

			<ul class="space-y-3">
				{comparisons.map((c) => (
					<li>
						<a href={`/compare/${c.slug}`} class="block bg-white/5 rounded-2xl border border-white/10 p-5 hover:bg-white/10 transition-colors">
							<h2 class="text-lg font-semibold text-white mb-1">BetterCapture vs {c.competitor}</h2>
							<p class="text-sm text-white/60">{c.summary}</p>
						</a>
					</li>
				))}
			</ul>
		</div>
	</main>
</BaseLayout>
